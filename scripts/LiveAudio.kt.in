package {{PACKAGE}}

import android.Manifest
import android.content.Context
import android.content.pm.PackageManager
import android.media.*
import android.media.audiofx.AcousticEchoCanceler
import android.media.audiofx.NoiseSuppressor
import android.os.Handler
import android.os.Looper
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.EventChannel
import io.flutter.plugin.common.MethodChannel
import java.util.concurrent.LinkedBlockingQueue
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import kotlin.math.sqrt

/** One continuous foreground AudioRecord session, including during playback. */
class LiveAudio(private val context: Context, messenger: BinaryMessenger) {
    private val main = Handler(Looper.getMainLooper())
    @Volatile private var foreground = false
    fun setForeground(value: Boolean) { foreground = value; if (!value) stop() }
    private val running = AtomicBoolean(false)
    private val epoch = AtomicInteger(0)
    private val queue = LinkedBlockingQueue<Pair<Int, ByteArray>>(800)
    private var sink: EventChannel.EventSink? = null
    private var record: AudioRecord? = null
    private var track: AudioTrack? = null
    private var inputThread: Thread? = null
    private var outputThread: Thread? = null
    private var echo: AcousticEchoCanceler? = null
    private var noise: NoiseSuppressor? = null
    private val manager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
    private var previousMode = AudioManager.MODE_NORMAL
    private var previousSpeaker = false
    private var focus: AudioFocusRequest? = null
    private var ownsAudio = false
    private val pendingInput = AtomicInteger(0)
    private val focusListener = AudioManager.OnAudioFocusChangeListener { change ->
        if (change == AudioManager.AUDIOFOCUS_LOSS || change == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT) {
            main.post { stop(); sink?.success(mapOf("type" to "focus_lost")) }
        }
    }
    init {
        EventChannel(messenger, "mimo/live/events").setStreamHandler(object: EventChannel.StreamHandler {
            override fun onListen(arguments: Any?, events: EventChannel.EventSink) { sink = events }
            override fun onCancel(arguments: Any?) { stop(); sink = null }
        })
        MethodChannel(messenger, "mimo/live/audio").setMethodCallHandler { call, result ->
            try {
                when (call.method) {
                    "start" -> { start(); result.success(mapOf("echoCancellation" to (echo?.enabled == true))) }
                    "stop" -> { stop(); result.success(null) }
                    "clear" -> { clear(); result.success(null) }
                    "play" -> {
                        val bytes = call.arguments as? ByteArray ?: error("Invalid PCM")
                        check(bytes.size <= 192000 && bytes.size % 2 == 0) { "Invalid PCM size" }
                        // Split into 20 ms blocks. Never feed seconds of PCM to AudioTrack at once.
                        val id = epoch.get()
                        var offset = 0
                        while (running.get() && offset < bytes.size) {
                            val end = minOf(offset + 960, bytes.size)
                            check(queue.offer(Pair(id, bytes.copyOfRange(offset, end)))) { "Playback backlog" }
                            offset = end
                        }
                        result.success(null)
                    }
                    else -> result.notImplemented()
                }
            } catch (e: Exception) { stop(); result.error("LIVE_AUDIO", e.message, null) }
        }
    }
    @Suppress("DEPRECATION")
    private fun start() {
        if (running.get()) return
        check(foreground) { "Application is not in foreground" }
        check(sink != null) { "Audio events not connected" }
        check(context.checkSelfPermission(Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED) { "Microphone permission required" }
        ownsAudio = true
        previousMode = manager.mode; previousSpeaker = manager.isSpeakerphoneOn
        val attributes = AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_VOICE_COMMUNICATION).setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build()
        val granted = if (android.os.Build.VERSION.SDK_INT >= 26) {
            val request = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN).setAudioAttributes(attributes).setOnAudioFocusChangeListener(focusListener).build()
            focus = request; manager.requestAudioFocus(request)
        } else manager.requestAudioFocus(focusListener, AudioManager.STREAM_VOICE_CALL, AudioManager.AUDIOFOCUS_GAIN)
        check(granted == AudioManager.AUDIOFOCUS_REQUEST_GRANTED) { "Audio focus unavailable" }
        manager.mode = AudioManager.MODE_IN_COMMUNICATION
        // Respect an attached headset; otherwise use the loudspeaker with AEC.
        val headset = manager.getDevices(AudioManager.GET_DEVICES_OUTPUTS).any { it.type in listOf(AudioDeviceInfo.TYPE_WIRED_HEADSET, AudioDeviceInfo.TYPE_WIRED_HEADPHONES, AudioDeviceInfo.TYPE_BLUETOOTH_SCO, AudioDeviceInfo.TYPE_USB_HEADSET) }
        manager.isSpeakerphoneOn = !headset
        val inputSize = maxOf(3200, AudioRecord.getMinBufferSize(16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT))
        val r = AudioRecord(MediaRecorder.AudioSource.VOICE_COMMUNICATION, 16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, inputSize)
        record = r; check(r.state == AudioRecord.STATE_INITIALIZED) { "Recorder unavailable" }
        if (AcousticEchoCanceler.isAvailable()) echo = AcousticEchoCanceler.create(r.audioSessionId)?.also { it.enabled = true }
        if (NoiseSuppressor.isAvailable()) noise = NoiseSuppressor.create(r.audioSessionId)?.also { it.enabled = true }
        val format = AudioFormat.Builder().setSampleRate(24000).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).setEncoding(AudioFormat.ENCODING_PCM_16BIT).build()
        val outputSize = maxOf(4800, AudioTrack.getMinBufferSize(24000, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT))
        val t = AudioTrack.Builder().setAudioAttributes(attributes).setAudioFormat(format).setBufferSizeInBytes(outputSize).setTransferMode(AudioTrack.MODE_STREAM).build()
        track = t; check(t.state == AudioTrack.STATE_INITIALIZED) { "Playback unavailable" }
        t.setBufferSizeInFrames(2400)
        running.set(true); val session = epoch.incrementAndGet()
        r.startRecording(); t.play()
        inputThread = Thread({
            android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_AUDIO)
            val bytes = ByteArray(640)
            while (running.get() && record === r) {
                val size = r.read(bytes, 0, bytes.size, AudioRecord.READ_BLOCKING)
                if (size <= 0) { main.post { if (record === r) { stop(); sink?.success(mapOf("type" to "audio_error")) } }; break }
                if (pendingInput.get() < 5) {
                    val pcm = bytes.copyOf(size); pendingInput.incrementAndGet()
                    main.post { pendingInput.decrementAndGet(); if (running.get() && record === r) sink?.success(pcm) }
                }
            }
        }, "mimo-microphone").also { it.start() }
        outputThread = Thread({
            android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_AUDIO)
            var speaking = false
            var lastLevel = 0L
            while (running.get() && track === t) {
                val block = try { queue.poll(150, java.util.concurrent.TimeUnit.MILLISECONDS) } catch (_: InterruptedException) { break }
                if (block == null) {
                    if (speaking) { speaking = false; main.post { if (track === t) sink?.success(mapOf("type" to "level", "value" to 0.0)) } }
                    continue
                }
                synchronized(this) {
                    if (block.first == epoch.get() && running.get() && track === t) {
                        val count = t.write(block.second, 0, block.second.size, AudioTrack.WRITE_BLOCKING)
                        if (count > 0) {
                            var power = 0.0
                            for (i in 0 until count - 1 step 2) { val v = ((block.second[i].toInt() and 255) or (block.second[i+1].toInt() shl 8)).toShort().toDouble()/32768; power += v*v }
                            val level = minOf(1.0, sqrt(power / maxOf(1, count/2)) * 5)
                            speaking = true
                            val now = android.os.SystemClock.elapsedRealtime()
                            if (now - lastLevel >= 75) {
                                lastLevel = now
                                main.post { if (track === t && block.first == epoch.get()) sink?.success(mapOf("type" to "level", "value" to level)) }
                            }
                        }
                    }
                }
            }
        }, "mimo-playback-$session").also { it.start() }
    }
    @Synchronized fun clear() {
        epoch.incrementAndGet(); queue.clear()
        track?.let { if (it.state == AudioTrack.STATE_INITIALIZED) { it.pause(); it.flush(); if (running.get()) it.play() } }
        sink?.success(mapOf("type" to "level", "value" to 0.0))
    }
    @Suppress("DEPRECATION")
    fun stop() {
        if (!ownsAudio && record == null && track == null) return
        ownsAudio = false
        running.set(false); epoch.incrementAndGet(); queue.clear()
        val r = record; record = null
        try { r?.stop() } catch (_: Exception) {}
        val t = track; track = null
        try { t?.pause(); t?.flush() } catch (_: Exception) {}
        outputThread?.interrupt()
        // Stop unblocks reads/writes before resources are released off the UI thread.
        val input = inputThread; val output = outputThread
        inputThread = null; outputThread = null
        val oldEcho = echo; val oldNoise = noise; echo = null; noise = null
        Thread({ input?.join(500); output?.join(500); oldEcho?.release(); oldNoise?.release(); r?.release(); t?.release() }, "mimo-audio-release").start()
        if (focus != null && android.os.Build.VERSION.SDK_INT >= 26) manager.abandonAudioFocusRequest(focus!!)
        else manager.abandonAudioFocus(focusListener)
        focus = null
        if (manager.mode == AudioManager.MODE_IN_COMMUNICATION) { manager.isSpeakerphoneOn = previousSpeaker; manager.mode = previousMode }
    }
}
